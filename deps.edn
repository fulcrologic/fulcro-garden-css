{:paths   ["src/main" "src/dev"]

 :deps    {garden/garden {:mvn/version "1.3.9"}}

 :aliases {:provided  {:extra-deps {org.clojure/clojure       {:mvn/version "1.12.0" :scope "provided"}
                                    org.clojure/clojurescript {:mvn/version "1.12.42" :scope "provided"}
                                    com.fulcrologic/fulcro    {:mvn/version "3.9.0-SNAPSHOT" :scope "provided"}
                                    edn-query-language/eql    {:mvn/version "1.0.1" :scope "provided"}}}
           :clj-tests {:extra-paths ["src/test"]
                       :main-opts   ["-m" "kaocha.runner"]
                       :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}}}

           :test      {:extra-paths ["src/test"]
                       :extra-deps  {org.clojure/tools.namespace {:mvn/version "1.4.4"}
                                     thheller/shadow-cljs        {:mvn/version "3.1.7"}
                                     fulcrologic/fulcro-spec     {:mvn/version "3.1.12"}}}}}
